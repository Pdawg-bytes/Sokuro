<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Authors>Pdawg</Authors>
    <Description>A fast, multi-threaded logging library for .NET designed for low latency and throughput</Description>
    <PackageTags>logging;performance;concurrent</PackageTags>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Pdawg-bytes/Sokuro</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeGeneratorInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sokuro.Generator\Sokuro.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Sokuro.Tests" />
    <InternalsVisibleTo Include="Sokuro.UnitTests" />
  </ItemGroup>

  <Target Name="IncludeGeneratorInPackage">
    <MSBuild Projects="..\Sokuro.Generator\Sokuro.Generator.csproj"
             Targets="GetTargetPath"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_GeneratorTargetPath" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_GeneratorTargetPath)" PackagePath="analyzers\dotnet\cs\" />
    </ItemGroup>
  </Target>

</Project>
